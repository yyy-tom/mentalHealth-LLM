{
  "_comment": "Qwen2.5-7B on single RTX 4090 (24GB) - QLoRA + aggressive memory optimization",

  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "dataset_path": "datasets/mental_health_with_crisis",
  "output_dir": "models/qwen2.5-7b-mental-health",

  "batch_size": 1,
  "num_epochs": 2,
  "learning_rate": 1e-4,
  "use_wandb": false,

  "use_4bit": true,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],

  "max_length": 768,
  "gradient_accumulation_steps": 16,
  "eval_batch_size": 1,

  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "logging_steps": 50,
  "eval_steps": 500,
  "save_steps": 1000,
  "save_total_limit": 2,

  "fp16": false,
  "bf16": true,
  "seed": 42,

  "gradient_checkpointing": true,
  "optim": "paged_adamw_8bit",
  "lr_scheduler_type": "cosine",

  "save_strategy": "steps",
  "eval_strategy": "steps",
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",

  "_hardware_notes": [
    "RTX 4090: 24GB VRAM",
    "Expected VRAM usage: ~18-22GB",
    "Effective batch size: 1 × 16 = 16",
    "Use paged_adamw_8bit to save optimizer memory",
    "Gradient checkpointing required",
    "If OOM: reduce max_length to 512"
  ]
}
