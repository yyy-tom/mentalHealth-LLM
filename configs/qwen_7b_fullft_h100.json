{
  "_comment": "Qwen2.5-7B FULL fine-tune on 1× H100 80GB — NO LoRA, NO quantization",

  "model_name": "Qwen/Qwen2.5-7B-Instruct",
  "dataset_path": "datasets/all_mental_health_combined",
  "output_dir": "models/qwen2.5-7b-mental-health-fullft",

  "full_finetune": true,
  "use_4bit": false,

  "batch_size": 4,
  "num_epochs": 3,
  "learning_rate": 2e-5,
  "use_wandb": false,

  "max_length": 1024,
  "gradient_accumulation_steps": 8,
  "eval_batch_size": 4,

  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "logging_steps": 25,
  "eval_steps": 500,
  "save_steps": 1000,
  "save_total_limit": 3,

  "fp16": false,
  "bf16": true,
  "seed": 42,

  "gradient_checkpointing": true,
  "optim": "adamw_torch_fused",
  "lr_scheduler_type": "cosine",

  "save_strategy": "steps",
  "eval_strategy": "steps",
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",

  "dataloader_num_workers": 4,
  "dataloader_pin_memory": true,

  "_hardware_notes": [
    "1× NVIDIA H100 80GB SXM — full fine-tune, no quantization",
    "Model bf16 weights: ~15 GB",
    "AdamW optimizer states: ~30 GB",
    "Gradients: ~15 GB",
    "Total static: ~60 GB, leaving ~20 GB for activations",
    "Gradient checkpointing ON to reduce activation memory",
    "Effective batch size: 1 GPU × 4 batch × 8 accum = 32",
    "Learning rate 2e-5 (lower than LoRA — full FT needs conservative LR)",
    "Estimated training time: ~8–12 hours for 3 epochs (591K examples)",
    "Launch: python scripts/train_qwen_fullft.py --config configs/qwen_7b_fullft_h100.json"
  ]
}
