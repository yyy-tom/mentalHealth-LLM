{
  "_comment": "LoRA adapter config for psychoeducation skill (~14K samples, 3 epochs)",
  "model_name": "models/qwen2.5-7b-mental-health-fullft-a100",
  "dataset_path": "datasets/skills/psychoeducation",
  "output_dir": "adapters/psychoeducation",
  "use_4bit": false,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "batch_size": 4,
  "learning_rate": 1e-4,
  "num_epochs": 3,
  "max_length": 768,
  "gradient_accumulation_steps": 8,
  "eval_batch_size": 4,
  "weight_decay": 0.01,
  "warmup_ratio": 0.03,
  "logging_steps": 50,
  "eval_steps": 500,
  "save_steps": 1000,
  "save_total_limit": 2,
  "fp16": false,
  "bf16": true,
  "seed": 42,
  "gradient_checkpointing": true,
  "optim": "adamw_torch_fused",
  "lr_scheduler_type": "cosine",
  "save_strategy": "steps",
  "eval_strategy": "steps",
  "load_best_model_at_end": true,
  "metric_for_best_model": "eval_loss",
  "run_name": "skill-lora-psychoeducation"
}
